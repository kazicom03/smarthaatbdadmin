rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Default-deny secure fallback
    match /{document=**} {
      allow read, write: if false;
    }

    // Products Collection: Public read, and write permissions for the admin panel.
    match /products/{productId} {
      allow read, write: if true;
    }

    // Orders Collection: Read and write for orders processing (customers place orders, admin manages them).
    match /orders/{orderId} {
      allow read, write: if true;
    }

    // Settings Collection: Store configuration details such as payment merchant IDs and shipping fees.
    match /settings/{settingId} {
      allow read, write: if true;
    }

    // Users Collection: Enable authenticated customer profiles and read operations by the admin panel.
    match /users/{userId} {
      allow read, write: if true;
    }
  }
}
