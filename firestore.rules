rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Default-deny secure fallback
    match /{document=**} {
      allow read, write: if false;
    }

    // Products Collection: Public read, and write permissions for the admin panel.
    match /products/{productId} {
      allow read, write: if true;
    }

    // Orders Collection: Read and write for orders processing (customers place orders, admin manages them).
    match /orders/{orderId} {
      allow read, write: if true;
    }

    // Settings Collection: Store configuration details such as payment merchant IDs and shipping fees.
    match /settings/{settingId} {
      allow read, write: if true;
    }

    // Users Collection: Enable authenticated customer profiles and read operations by the admin panel.
    match /users/{userId} {
      allow read, write: if true;
    }

    // Chat Sessions Collection: Support live chat sessions for both registered users and guests.
    match /chat_sessions/{sessionId} {
      allow read, write: if true;

      match /messages/{messageId} {
        allow read, write: if true;
      }
    }

    // Reviews Collection: Customers leave reviews, Admins moderate/delete reviews.
    match /reviews/{reviewId} {
      allow read, write: if true;
    }

    // Promo Codes Collection: Manage e-commerce promo code database.
    match /promo_codes/{codeId} {
      allow read, write: if true;
    }
  }
}
